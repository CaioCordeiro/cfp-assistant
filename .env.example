# Copy to .env and fill in values

# LLM provider
# Set to 'openai' (default) or 'huggingface'
LLM_PROVIDER=openai

# OpenAI (if provider=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Hugging Face (if provider=huggingface)
HUGGINGFACE_API_KEY=your_hf_api_key
HUGGINGFACE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Twilio (optional signature validation)
TWILIO_AUTH_TOKEN=your_twilio_auth_token
VALIDATE_TWILIO_SIGNATURE=false

# Twilio Account SID (used for media download auth)
TWILIO_ACCOUNT_SID=your_twilio_account_sid

# Public URL for webhook signature validation (optional override)
# PUBLIC_BASE_URL=https://your-ngrok-or-hostname

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=cfp-bot@example.com
FROM_NAME=CFP Assistant Bot

# Flask
FLASK_ENV=development
PORT=5000